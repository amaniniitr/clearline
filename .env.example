# Gemini on Vertex AI (default provider). Express-mode API key; never commit real keys.
VERTEX_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
MODEL_PROVIDER=gemini

# Optional alternatives
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=          # Jev (TypeSafe System One) via OpenRouter
TYPESAFE_API_KEY=

# live | fixture | auto (replay a saved response if there is one, else call the model, else run offline)
AI_MODE=auto
DAILY_SPEND_CAP_USD=10
DATABASE_URL=postgresql://localhost:5432/clearline
DBOS_DATABASE_URL=postgresql://localhost:5432/clearline_dbos
